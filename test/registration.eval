(ns registration-check
  (:require [argent.vendor.effect :as fx]
            [argent.vendor.event :as event]))

(let [state (atom 7)
      factories (atom 0)
      env (-> {}
              (fx/register :state:update (fn [f] (swap! state f)))
              (event/register :add
                              (fn [amount]
                                (swap! factories (fn [n] (+ n 1)))
                                (event/dispatch :state:update
                                                (fn [value] (+ value amount))))))
      call (event/dispatch :add 3)]
  (assert (= (deref factories) 0))
  (assert (= (deref state) 7))
  (assert (= (call env) 10))
  (assert (= (deref state) 10))
  (assert (= (deref factories) 1))
  (let [replacement (atom 40)
        other (fx/register env :state:update (fn [f] (swap! replacement f)))]
    (assert (= (call other) 43))
    (assert (= (deref replacement) 43))
    (assert (= (deref state) 10))))

(let [seen (atom nil)
      invoked (atom false)
      env (fx/register {} :save
                       (fn [value]
                         (reset! seen value)
                         (fn [] (reset! invoked true) value)))
      call (event/dispatch :save 23)]
  (assert (= (deref seen) nil))
  (let [result (call env)]
    (assert (= (deref seen) 23))
    (assert (= (deref invoked) false))
    (assert (= (result) 23))
    (assert (= (deref invoked) true))))
"registration ok"
